# Public documentation. Everything under docs/ stays local by default;
# only the explicit !/ lines below ship to the public repository. The
# split is intentional: durable prose, methodology, and hash-stable paper
# evidence are public; machine-specific benchmark results, raw PDFs, and
# transient extraction products stay local.
/docs/
!/docs/
/docs/*
!/docs/building.md
!/docs/precision.md
!/docs/testing.md
!/docs/benchmark-methodology.md
!/docs/comparison.md
!/docs/rust-cpu-benchmarks.md
!/docs/papers/
/docs/papers/**
!/docs/papers/**/
!/docs/papers/**/*.md
!/docs/papers/desktop-review/manifest.json
!/docs/papers/desktop-review/summary.json
!/docs/papers/**/results/*.json
!/docs/papers/**/results/*.csv
!/docs/papers/**/results/*.svg

# Raw papers and temporary extraction/rendering products are not source.
/docs/papers/**/*.pdf
/docs/papers/**/extracted.txt
/docs/papers/**/page-*.txt
/docs/papers/**/page-*.png
/docs/papers/**/results/test-output.txt

# Bulk paper-search vectors and transient archives stay local.
/docs/papers/**/*.npz
/docs/papers/**/*.npy
/docs/papers/**/*.jsonl
/docs/papers/**/*.json.tmp
